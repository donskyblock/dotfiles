# Public defaults only. Identity and signing key live in untracked local.conf.
[user]
    useConfigOnly = true
[init]
    defaultBranch = main
[core]
    excludesFile = ~/.config/git/ignore
[fetch]
    prune = true
[pull]
    ff = only
[push]
    default = simple
    autoSetupRemote = true
[diff]
    algorithm = histogram
    colorMoved = zebra
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
[alias]
    st = status --short --branch
    lg = log --oneline --graph --decorate -20
    last = log -1 --stat
    unstage = restore --staged
[include]
    path = ~/.config/git/local.conf
