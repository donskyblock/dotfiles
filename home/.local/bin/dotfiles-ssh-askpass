#!/usr/bin/env python3
"""Bridge OpenSSH's askpass protocol to the desktop's graphical Pinentry."""
import shutil
import subprocess
import sys
from urllib.parse import unquote_to_bytes


def main():
    program = shutil.which('pinentry-gnome3')
    if not program:
        return 1
    # Only OpenSSH receives the response on stdout. Never log prompt responses.
    process = subprocess.Popen([program], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    def response():
        data = []
        while True:
            line = process.stdout.readline()
            if not line:
                raise RuntimeError('Pinentry closed')
            if line.startswith(b'D '):
                data.append(unquote_to_bytes(line[2:].rstrip(b'\r\n')))
            elif line.startswith(b'OK'):
                return b''.join(data)
            elif line.startswith(b'ERR'):
                raise RuntimeError('Prompt cancelled')
    def command(text):
        process.stdin.write(text.encode('utf-8') + b'\n')
        process.stdin.flush()
        return response()
    try:
        response()
        command('SETTITLE SSH key passphrase')
        prompt = sys.argv[1] if len(sys.argv) > 1 else 'Enter your SSH key passphrase'
        escaped = prompt.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
        command('SETDESC ' + escaped)
        command('SETPROMPT Passphrase:')
        secret = command('GETPIN')
        sys.stdout.buffer.write(secret + b'\n')
        sys.stdout.buffer.flush()
        return 0
    except (RuntimeError, BrokenPipeError):
        return 1
    finally:
        process.stdin.close()
        process.stdout.close()
        process.terminate()
        process.wait()


if __name__ == '__main__':
    raise SystemExit(main())
