{
  "workbench.colorTheme": "Tokyo Night COSMIC",
  "workbench.preferredDarkColorTheme": "Tokyo Night COSMIC",
  "workbench.iconTheme": "vs-seti",
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "workbench.activityBar.location": "default",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.editor.tabSizing": "shrink",
  "breadcrumbs.enabled": true,
  "editor.fontFamily": "'DejaVu Sans Mono', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 23,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "all",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.padding.top": 14,
  "editor.padding.bottom": 14,
  "terminal.integrated.fontFamily": "'DejaVu Sans Mono'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.minimumContrastRatio": 4.5
}
