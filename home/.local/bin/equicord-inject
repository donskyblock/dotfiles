#!/usr/bin/env python3
"""Patch only the user-owned native Discord with a local Equicord build."""
import json
import os
from pathlib import Path
import subprocess
import sys

home = Path.home()
state = home / '.local/state/dotfiles/discord'
settings = state / 'equicord-source.json'
if len(sys.argv) > 2:
    raise SystemExit('Usage: equicord-inject [EQUICORD_SOURCE_DIRECTORY]')
if len(sys.argv) == 2:
    source = Path(sys.argv[1]).expanduser().resolve()
elif settings.exists():
    source = Path(json.loads(settings.read_text())['path'])
else:
    raise SystemExit('Run equicord-inject /path/to/Equicord once to select your local build.')
installer = state / 'EquilotlCli-Linux'
if not installer.is_file():
    raise SystemExit('The cached Equilotl installer is missing; run the native Discord setup again.')
build = source / 'dist/desktop'
if not (build / 'patcher.js').is_file():
    raise SystemExit('Build Equicord first: pnpm --dir ' + str(source) + ' build')
target = home / '.local/opt/discord'
if not (target / 'Discord').is_file():
    raise SystemExit('Native Discord is not installed.')
env = dict(os.environ, EQUICORD_DEV_INSTALL='1', EQUICORD_DIRECTORY=str(build), EQUICORD_USER_DATA_DIR=str(home / '.config/Equicord'))
subprocess.run([str(installer), '--install', '--location', str(target)], env=env, check=True)
state.mkdir(parents=True, exist_ok=True)
settings.write_text(json.dumps({'path': str(source)}, indent=2) + '\n')
print('Equicord patched the native user-owned install. Fully restart native Discord to load it.')
